# AIOps Sentinel Environment Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# SQLite Database
DATABASE_URL=sqlite:///./sentinel.db

# Fake Store API Configuration
FAKESTORE_API_URL=https://fakestoreapi.com
CATALOG_CACHE_TTL_SECONDS=3600

# Monitoring & AIOps Settings
TELEMETRY_INTERVAL_SECONDS=2
ADAPTIVE_WINDOW_SIZE=30
ADAPTIVE_MAD_MULTIPLIER=3.0
MIN_OBSERVATIONS_FOR_ADAPTIVE=10
ISOLATION_FOREST_CONTAMINATION=0.05

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-use-a-strong-password
